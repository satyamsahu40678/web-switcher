{
  "manifest_version": 3,
  "name": "Web Switcher",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Follow website moves with local controls, expiring mappings, and signed registry verification.",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Web Switcher",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "route.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
