# Optional service; the browser's archive mode does not need this service.
ONLINE_DISCOVERY_ENABLED=false
ONLINE_BIND=127.0.0.1
ONLINE_PORT=8082
ONLINE_DATABASE_PATH=/var/lib/web-switcher-discovery/state.sqlite
# Supply distinct cryptographically random base64url invitations securely.
# One token represents one user/account budget and job-ownership namespace.
ONLINE_ACCESS_TOKENS=
ONLINE_ALLOWED_ORIGINS=
ONLINE_CONCURRENCY=2
ONLINE_ARCHIVE_ENABLED=true
# Optional official broad-search provider; server only, never extension code.
BRAVE_SEARCH_API_KEY=
# Optional operator-selected internal isolated fetcher; configure BOTH or neither.
FETCHER_URL=
FETCHER_INTERNAL_TOKEN=
