# Copy to /srv/web-switcher/config/runtime.env; this file contains NO secrets.
# Replace all examples with owned DNS/provider values and a reviewed PG17 digest.
# Set these to the non-root deploy/config owner: id -u; id -g
RUNTIME_UID=1000
RUNTIME_GID=1000
PUBLIC_HOST=staging.your-owned-domain.example
APP_PUBLIC_ORIGIN=https://staging.your-owned-domain.example
ACME_EMAIL=operator@your-owned-domain.example
POSTGRES_IMAGE=docker.io/library/postgres@sha256:REPLACE_WITH_REVIEWED_POSTGRES_17_DIGEST
OIDC_CLIENT_ID=REPLACE_WITH_STAGING_OIDC_CLIENT_ID
OIDC_ISSUER_URI=https://your-owned-oidc-provider.example
ADMIN_ALLOWED_SUBJECTS=REPLACE_WITH_REVIEWER_SUBJECT
PUBLISHER_ALLOWED_SUBJECTS=REPLACE_WITH_DISTINCT_PUBLISHER_SUBJECT
# Publisher has no published port; configure its private TLS/admin gateway first.
PUBLISHER_PUBLIC_ORIGIN=https://publisher.private.your-owned-domain.example
PUBLISHER_OIDC_CLIENT_ID=REPLACE_WITH_PRIVATE_PUBLISHER_OIDC_CLIENT_ID
PUBLISHING_KEY_ID=REPLACE_WITH_PINNED_PUBLISHING_KEY_ID
